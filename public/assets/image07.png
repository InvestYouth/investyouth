<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 680" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f0fdf4" />
      <stop offset="30%" stop-color="#ecfdf5" />
      <stop offset="70%" stop-color="#e6f4ea" />
      <stop offset="100%" stop-color="#d1fae5" />
    </linearGradient>
    <linearGradient id="darkGreenGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#064e3b" />
      <stop offset="50%" stop-color="#065f46" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>
    <linearGradient id="greenPillGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#047857" />
      <stop offset="100%" stop-color="#064e3b" />
    </linearGradient>
    <filter id="cardShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.12" />
    </filter>
  </defs>

  <!-- Canvas Background -->
  <rect width="1600" height="680" fill="url(#bgGrad)" />

  <!-- Background Stock Chart Candlesticks -->
  <g opacity="0.22">
    <!-- Candlesticks in background center-left -->
    <line x1="620" y1="100" x2="620" y2="260" stroke="#10b981" stroke-width="2" />
    <rect x="612" y="140" width="16" height="70" rx="2" fill="#10b981" />
    
    <line x1="660" y1="80" x2="660" y2="240" stroke="#10b981" stroke-width="2" />
    <rect x="652" y="110" width="16" height="90" rx="2" fill="#10b981" />

    <line x1="700" y1="120" x2="700" y2="280" stroke="#ef4444" stroke-width="2" />
    <rect x="692" y="150" width="16" height="60" rx="2" fill="#ef4444" />

    <line x1="740" y1="90" x2="740" y2="230" stroke="#10b981" stroke-width="2" />
    <rect x="732" y="115" width="16" height="85" rx="2" fill="#10b981" />

    <line x1="1060" y1="80" x2="1060" y2="260" stroke="#10b981" stroke-width="2" />
    <rect x="1052" y="120" width="16" height="95" rx="2" fill="#10b981" />

    <line x1="1100" y1="100" x2="1100" y2="280" stroke="#ef4444" stroke-width="2" />
    <rect x="1092" y="140" width="16" height="70" rx="2" fill="#ef4444" />

    <line x1="1140" y1="70" x2="1140" y2="230" stroke="#10b981" stroke-width="2" />
    <rect x="1132" y="95" width="16" height="100" rx="2" fill="#10b981" />
  </g>

  <!-- TOP LEFT LOGO SECTION -->
  <g transform="translate(50, 45)">
    <!-- Circle Icon -->
    <circle cx="55" cy="55" r="50" fill="#047857" />
    <circle cx="55" cy="55" r="45" fill="none" stroke="#ffffff" stroke-width="2.5" />
    <!-- iY monogram -->
    <text x="38" y="68" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="42" font-weight="800" fill="#ffffff">i</text>
    <text x="53" y="68" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="42" font-weight="900" fill="#ffffff">Y</text>
    <!-- Arrow inside Y -->
    <path d="M 66 52 L 78 36 M 78 36 L 70 36 M 78 36 L 78 44" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    
    <!-- InvestYouth.in text -->
    <text x="125" y="60" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="52" font-weight="900" fill="#0f172a">Invest<tspan fill="#047857">Youth</tspan><tspan fill="#0f172a" font-size="36">.in</tspan></text>
    <text x="130" y="88" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="16" font-weight="700" letter-spacing="6" fill="#0f172a">LEARN  |  INVEST  |  GROW</text>
  </g>

  <!-- MARKET TICKER TICKETS -->
  <g transform="translate(610, 50)">
    <text x="0" y="28" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="24" font-weight="800" fill="#065f46">NIFTY 50</text>
    <text x="0" y="58" font-family="monospace" font-size="26" font-weight="800" fill="#0f172a">24,836.20</text>
    <text x="0" y="84" font-family="monospace" font-size="20" font-weight="700" fill="#059669">+1.35% ▲</text>
  </g>

  <g transform="translate(1120, 50)">
    <text x="0" y="28" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="24" font-weight="800" fill="#065f46">SENSEX</text>
    <text x="0" y="58" font-family="monospace" font-size="26" font-weight="800" fill="#0f172a">81,721.08</text>
    <text x="0" y="84" font-family="monospace" font-size="20" font-weight="700" fill="#059669">+1.28% ▲</text>
  </g>

  <!-- LEFT HEADLINE BLOCK -->
  <g transform="translate(50, 200)">
    <text x="0" y="45" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="50" font-weight="900" fill="#0f172a">Learn Today.</text>
    <text x="0" y="105" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="50" font-weight="900" fill="#047857">Invest Smart.</text>
    <text x="0" y="165" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="50" font-weight="900" fill="#0f172a">Grow for Tomorrow.</text>

    <!-- 3 ROUND BADGES: LEARN, INVEST, GROW -->
    <g transform="translate(0, 200)">
      <!-- LEARN -->
      <g transform="translate(0, 0)">
        <circle cx="35" cy="35" r="32" fill="#047857" />
        <path d="M 23 35 Q 35 30 35 44 Q 35 30 47 35 M 23 27 Q 35 22 35 36 Q 35 22 47 27 L 47 38 Q 35 33 35 47 Q 35 33 23 38 Z" fill="none" stroke="#ffffff" stroke-width="2" />
        <text x="35" y="90" text-anchor="middle" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="14" font-weight="800" fill="#0f172a" letter-spacing="1.5">LEARN</text>
      </g>

      <!-- INVEST -->
      <g transform="translate(110, 0)">
        <circle cx="35" cy="35" r="32" fill="#047857" />
        <!-- Bar chart trending up -->
        <rect x="23" y="38" width="5" height="12" fill="#ffffff" />
        <rect x="32" y="32" width="5" height="18" fill="#ffffff" />
        <rect x="41" y="25" width="5" height="25" fill="#ffffff" />
        <path d="M 22 34 L 33 27 L 46 20" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
        <text x="35" y="90" text-anchor="middle" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="14" font-weight="800" fill="#0f172a" letter-spacing="1.5">INVEST</text>
      </g>

      <!-- GROW -->
      <g transform="translate(220, 0)">
        <circle cx="35" cy="35" r="32" fill="#047857" />
        <!-- Sprout -->
        <path d="M 35 48 L 35 32 M 35 32 C 35 24 24 24 24 32 C 24 38 35 38 35 38 M 35 28 C 35 20 46 20 46 28 C 46 34 35 34 35 34" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" fill="none" />
        <text x="35" y="90" text-anchor="middle" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="14" font-weight="800" fill="#0f172a" letter-spacing="1.5">GROW</text>
      </g>
    </g>

    <!-- White Ribbon / Banner: Building Wealth. Creating Freedom. -->
    <g transform="translate(0, 320)">
      <rect x="0" y="0" width="440" height="52" rx="8" fill="#ffffff" filter="url(#cardShadow)" />
      <text x="24" y="34" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="20" font-weight="800" fill="#0f172a">
        Building <tspan fill="#047857">Wealth</tspan>. Creating <tspan fill="#0284c7">Freedom</tspan>.
      </text>
    </g>
  </g>

  <!-- CENTER: DIVERSE INDIAN YOUTH COMPOSITE PHOTO -->
  <g transform="translate(540, 110)">
    <clipPath id="centerClip">
      <rect x="0" y="0" width="680" height="470" rx="24" />
    </clipPath>
    <g clip-path="url(#centerClip)">
      <!-- High-res Unsplash Indian & diverse young professionals learning with laptop -->
      <image href="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&amp;fit=crop&amp;w=1400&amp;q=85" x="-50" y="-20" width="780" height="510" preserveAspectRatio="xMidYMid slice" />
      
      <!-- Subtle bottom gradient overlay -->
      <rect x="0" y="320" width="680" height="150" fill="url(#greenPillGrad)" opacity="0.85" />
      
      <!-- Embedded overlay badge on laptop -->
      <g transform="translate(280, 360)">
        <rect x="0" y="0" width="120" height="38" rx="19" fill="#047857" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
        <text x="60" y="24" text-anchor="middle" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="14" font-weight="900" fill="#ffffff">iY Invest</text>
      </g>
      
      <text x="340" y="430" text-anchor="middle" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="16" font-weight="700" fill="#ffffff">
        500+ Indian Campuses • 85,000+ Young Investors
      </text>
    </g>
  </g>

  <!-- RIGHT SIDE: 4 PILLARS & BSE ICONIC TOWER -->
  <g transform="translate(1260, 140)">
    <!-- Pillar 1: Financial Education -->
    <g transform="translate(0, 0)">
      <circle cx="20" cy="20" r="18" fill="#047857" />
      <path d="M 10 20 L 20 14 L 30 20 L 20 25 Z M 15 22.5 L 15 28 C 15 30 25 30 25 28 L 25 22.5" stroke="#ffffff" stroke-width="1.5" fill="none" />
      <text x="48" y="25" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="15" font-weight="800" fill="#0f172a">FINANCIAL EDUCATION</text>
    </g>

    <!-- Pillar 2: Smart Strategies -->
    <g transform="translate(0, 60)">
      <circle cx="20" cy="20" r="18" fill="#047857" />
      <!-- Lightbulb -->
      <path d="M 16 16 C 16 12 24 12 24 16 C 24 19 22 20 22 22 L 18 22 C 18 20 16 19 16 16 Z M 18 25 L 22 25" stroke="#ffffff" stroke-width="1.5" fill="none" />
      <text x="48" y="25" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="15" font-weight="800" fill="#0f172a">SMART STRATEGIES</text>
    </g>

    <!-- Pillar 3: Discipline -->
    <g transform="translate(0, 120)">
      <circle cx="20" cy="20" r="18" fill="#047857" />
      <!-- Bar Chart with line -->
      <path d="M 12 26 L 12 20 M 17 26 L 17 16 M 22 26 L 22 13 M 27 26 L 27 10" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
      <text x="48" y="25" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="15" font-weight="800" fill="#0f172a">DISCIPLINE</text>
    </g>

    <!-- Pillar 4: Long Term Wealth -->
    <g transform="translate(0, 180)">
      <circle cx="20" cy="20" r="18" fill="#047857" />
      <!-- Rupee symbol -->
      <text x="20" y="26" text-anchor="middle" font-family="sans-serif" font-size="18" font-weight="800" fill="#ffffff">₹</text>
      <text x="48" y="25" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="15" font-weight="800" fill="#0f172a">LONG TERM WEALTH</text>
    </g>

    <!-- Slogan Box -->
    <g transform="translate(0, 250)">
      <rect x="0" y="0" width="310" height="80" rx="12" fill="#ffffff" filter="url(#cardShadow)" />
      <text x="20" y="32" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="15" font-weight="700" fill="#334155">
        The Right <tspan fill="#047857" font-weight="900">Knowledge</tspan> Today,
      </text>
      <text x="20" y="58" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="15" font-weight="700" fill="#334155">
        Builds Your <tspan fill="#0284c7" font-weight="900">Freedom</tspan> Tomorrow.
      </text>
    </g>
  </g>

  <!-- BOTTOM DARK GREEN PILLAR STRIP -->
  <g transform="translate(0, 600)">
    <rect width="1600" height="80" fill="url(#darkGreenGrad)" />
    
    <g transform="translate(100, 48)">
      <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="16" font-weight="800" fill="#ffffff" letter-spacing="2">
        📈  STOCK MARKET
      </text>
    </g>

    <line x1="430" y1="20" x2="430" y2="60" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" />

    <g transform="translate(480, 48)">
      <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="16" font-weight="800" fill="#ffffff" letter-spacing="2">
        ₹  MUTUAL FUNDS
      </text>
    </g>

    <line x1="810" y1="20" x2="810" y2="60" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" />

    <g transform="translate(860, 48)">
      <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="16" font-weight="800" fill="#ffffff" letter-spacing="2">
        📊  OPTIONS TRADING
      </text>
    </g>

    <line x1="1200" y1="20" x2="1200" y2="60" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" />

    <g transform="translate(1250, 48)">
      <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="16" font-weight="800" fill="#ffffff" letter-spacing="2">
        🎯  FINANCIAL FREEDOM
      </text>
    </g>
  </g>
</svg>